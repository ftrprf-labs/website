# FTRLABS Invitation Manager — configuration
# Copy to `.env` (loaded automatically) and adjust. Never commit the real .env.

# Port for the local admin server.
PORT=4321

# Base host of the Maculis journey. Personal links become:
#   {MACULIS_HOST}/?p=<opaque-token>
# Canonieke productiehost: https://www.maculis.nl
# Lokaal testen kan tegen een lokale Maculis: MACULIS_HOST=http://localhost:8137
MACULIS_HOST=https://www.maculis.nl

# Server-to-server sync key for "Publiceer naar Maculis".
# Must match MACULIS_SYNC_KEY on the Maculis side. Leave empty to disable publish.
MACULIS_SYNC_KEY=

# Server-to-server key for the automatic Pass the Lens intake (POST /api/intake).
# Leave empty to DISABLE intake (endpoint returns 503). Never a public intake.
INTAKE_KEY=

# Admin gate. This is a SINGLE-PASSWORD local-admin gate, NOT production auth.
# If left empty, the server refuses to bind to anything but 127.0.0.1 and prints
# a warning — see SECURITY notes in README.md.
ADMIN_PASSWORD=

# Optional: bind address. Defaults to 127.0.0.1 (loopback only) which is the
# safe default for an internal admin tool. Only change this if you have put a
# real authenticating reverse-proxy in front of it.
HOST=127.0.0.1

# --- E-mail invitation transport (server/mailer.mjs) ------------------------
# No credentials in code. Leave MAIL_TRANSPORT empty and "Via e-mail uitnodigen"
# will NOT send and will NOT mark anyone INVITED (no fake-send).
#   http → POST each mail to MAIL_API_URL (optionally with a Bearer key).
#   mock → deterministic TEST transport for local verification only.
MAIL_TRANSPORT=
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
