# FTRLABS Invitation Manager — configuration
# Copy to `.env` (loaded automatically) and adjust. Never commit the real .env.
# In a managed deployment (Render) you set these in the dashboard, NOT in a file.

# Port for the server. Managed platforms (Render) inject PORT automatically.
PORT=4321

# Bind address. Defaults to 127.0.0.1 (loopback only) — the safe default for a
# local admin tool. Online (Render) this must be 0.0.0.0 (the Dockerfile sets it),
# and then ADMIN_PASSWORD is mandatory (the server refuses to expose an open UI).
HOST=127.0.0.1

# Set to "production" in a real deployment. Turns on fail-closed checks:
# ADMIN_PASSWORD + AUTH_SECRET required, and MACULIS_PUBLIC_URL must be a public
# https URL (never localhost). The Dockerfile sets this to production.
NODE_ENV=

# --- Maculis Journey URLs ---------------------------------------------------
# INTERNAL server-to-server base (publish + session-export calls).
MACULIS_HOST=https://www.maculis.nl
# PUBLIC base for the tester's personal link: {MACULIS_PUBLIC_URL}/?p=<token>.
# This is what a tester opens on their phone. Must be a browser-reachable https
# URL; in production it may NEVER be localhost. Falls back to MACULIS_HOST if unset.
MACULIS_PUBLIC_URL=

# --- Secrets (env vars only; never commit real values) ----------------------
# Server-to-server sync key for "Publiceer naar Maculis" (must match the Journey).
MACULIS_SYNC_KEY=
# Read key for pulling Maculis session/evaluation results (must match the Journey).
MACULIS_EXPORT_KEY=
# Server-to-server key for the automatic Pass the Lens intake (POST /api/intake).
# Leave empty to DISABLE intake (endpoint returns 503). Never a public intake.
INTAKE_KEY=

# Admin login password. Empty → the server runs OPEN and refuses any non-loopback
# bind (local-only). Online this is REQUIRED.
ADMIN_PASSWORD=
# Session-signing secret (long random string). REQUIRED in production so admin
# logins survive restarts/redeploys. Generate e.g. with: openssl rand -hex 32
AUTH_SECRET=

# Where the JSON store lives. Local default is ./data. In a managed deployment
# point this at a PERSISTENT disk mount (e.g. /var/data on Render).
DATA_DIR=

# --- E-mail invitation transport (server/mailer.mjs) ------------------------
# No credentials in code. Empty MAIL_TRANSPORT → "Via e-mail uitnodigen" will NOT
# send and will NOT mark anyone INVITED (no fake-send).
#   resend → transactional send via Resend. Needs MAIL_API_KEY + MAIL_FROM.
#   http   → POST each mail to MAIL_API_URL (optionally a Bearer key).
#   mock   → deterministic TEST transport for local verification only.
MAIL_TRANSPORT=
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=

# --- Communication / Relationship Layer (§Maculis Communication Layer) --------
# OFF unless BOTH the flag and a database are set, so Testerbeheer / First Five are
# completely unaffected until this is deliberately switched on.
COMM_LAYER_ENABLED=
# Postgres connection string. Render injects this for a linked Postgres. Managed
# Postgres uses TLS automatically; a local test DB may add ?sslmode=disable.
DATABASE_URL=
# Resend inbound (Receiving) webhook signing secret — set AFTER creating the webhook
# in Resend. Without it inbound e-mail is rejected (signature required).
RESEND_WEBHOOK_SECRET=
# Which @maculis.nl addresses the layer processes (others are ignored).
COMM_MAILBOXES=hello@maculis.nl,privacy@maculis.nl

# --- Digital Colleagues (agents; §TEAM & AGENTS ARCHITECTURE) ------------------
# Activatable INDEPENDENTLY of the Communication Layer. OFF unless BOTH this flag and
# DATABASE_URL are set. The agent schema (migration 006) shares the same Postgres and is
# applied on boot when either the Comm Layer or the agent domain is enabled. Routes live under
# /api/agents/* (admin-gated). No external web research or outbound is wired in this build.
AGENTS_ENABLED=
# Reasoning engine for the Growth/Lead colleague (Scout). 'internal' (default) is deterministic and
# never fabricates leads. 'external_web' is a not-yet-configured seam that returns nothing.
AGENT_DISCOVERY_PROVIDER=internal
# Credential-free website SIGNAL source: lets Scout read an organisation's OWN public homepage
# (robots.txt respected, one request, short snippets only) to observe positioning/hiring/news signals.
# OFF by default. Switching it ON means Scout makes live external HTTP requests (no API key needed).
# docs/architecture/SCOUT_DISCOVERY_SOURCES.md.
SCOUT_WEBSITE_SIGNALS=
# TED (EU public procurement, Tenders Electronic Daily) SIGNAL source. Anonymous, credential-free.
# OFF by default. On => Scout makes live external HTTP requests to the public TED API. No key.
SCOUT_TED=
# KVK (NL Handelsregister) VERIFICATION. Fully prepared but OFF until a key is set. Requires a Dutch
# registered entity + a paid (cheap) API subscription. Set the key ONLY in the environment, never in
# code. Leave empty to keep KVK off. KBO/BCE (Belgium) is a documented seam (free open data, but bulk
# ingest is a product decision) and is not wired.
KVK_API_KEY=
KVK_API_BASE=https://api.kvk.nl

# --- AI Communication Copilot (vendor-neutral; §AI PROVIDER ABSTRACTION) -------
# 'mock' (default) → deterministic, offline, no external call, fully testable.
# 'anthropic' → Claude Messages API; needs COMM_AI_API_KEY. Communication keeps
# working if AI is unavailable (§FALLBACK).
COMM_AI_PROVIDER=mock
COMM_AI_API_KEY=
COMM_AI_MODEL=claude-sonnet-5

# --- Omnichannel providers (official routes only; MOCK until credentials set) --
# WhatsApp Business Cloud API (Meta). No scraping/automation, ever.
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# SMS (EU-friendly provider, e.g. MessageBird/Bird or Twilio).
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_ORIGINATOR=
# Telephony (EU voice provider). Recording/transcription are explicit, off-by-default.
PHONE_PROVIDER=
PHONE_API_KEY=
PHONE_NUMBER=

# --- Mijn Maculis (customer environment) --------------------------------------
# Mijn Maculis reuses the Communication Layer's Postgres (COMM_LAYER_ENABLED +
# DATABASE_URL above). It needs NO new provider, key or paid service. Customers
# enter with an opaque, org-scoped access token (customer_access row); the raw
# token is never stored (only its SHA-256). Production stays inert until a real
# customer_access grant is created deliberately.
#
# Preview only: a reproducible token for the seeded demo org "De Voorbeeld Groep"
# (node scripts/seed-mijn-preview.mjs). The seed HARD-REFUSES when
# NODE_ENV=production, so no fixture data can ever reach production.
MIJN_PREVIEW_TOKEN=
