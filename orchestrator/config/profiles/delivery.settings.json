      "Bash(rm -rf:*)", "Bash(dropdb:*)", "Bash(psql * DROP*)", "Bash(* DROP DATABASE*)",
      "Bash(cat .env)", "Bash(cat *.env)", "Bash(printenv:*)", "Bash(env)",
      "Read(./.env)", "Read(./.env.*)", "Read(**/.env)", "Read(**/secrets*)",
      "Bash(vercel * --prod:*)", "Bash(render deploy:*)"
    ]
  }
